{
  "expo": {
    "name": "Duka IQ",
    "slug": "dukaiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/dukaiq.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kimarugregory.dukaiq"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/dukaiq.png",
        "backgroundImage": "./assets/dukaiq.png",
        "monochromeImage": "./assets/dukaiq.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kimarugregory.dukaiq"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/dukaiq.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/dukaiq.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-sqlite",
       [
        "expo-camera",
        {
          "cameraPermission": "Allow this app to access your camera to scan barcodes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a595d869-eb7e-49b9-940d-72d4e9cb29c4"
      }
    }
  }
}
